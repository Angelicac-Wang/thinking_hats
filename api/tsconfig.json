{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../lib/**/*.ts"]
}
